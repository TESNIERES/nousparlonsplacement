---
import Base from '../../layouts/Base.astro';
import { parCategorie, tempsLecture, termes } from '../../lib/content';
import { CATEGORIES, SITE, formatDate } from '../../lib/site';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { categorie: c.id }, props: { cat: c } }));
}
const { cat } = Astro.props;
const liste = parCategorie(cat.id);
const guides = liste.filter((a) => a.frontmatter.type === 'guide');
const autres = liste.filter((a) => a.frontmatter.type !== 'guide');
const mots = termes.filter((t) => t.frontmatter.categorie === cat.id);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: cat.titre,
    description: cat.description,
    url: `${SITE.url}/${cat.id}/`,
    inLanguage: 'fr-FR',
    hasPart: liste.map((a) => ({ '@type': 'Article', headline: a.frontmatter.title, url: `${SITE.url}${a.href}` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: cat.nom, item: `${SITE.url}/${cat.id}/` },
    ],
  },
];
---
<Base title={cat.titre} description={cat.description} jsonld={jsonld}>
  <div class="cadre">
    <nav class="fil" aria-label="Fil d'Ariane"><a href="/">Accueil</a><span aria-hidden="true">/</span><span>{cat.nom}</span></nav>
    <header class="lettrine-page intro-rubrique">
      <p class="rubrique" style="margin:18px 0 0">Rubrique</p>
      <h1>{cat.titre}</h1>
      <p class="chapo">{cat.intro}</p>
    </header>
    {guides.length > 0 && (
      <section class="section" style="padding-top:44px">
        <div class="section-tete"><div><p class="rubrique">Les guides</p><h2>Pour comprendre les bases</h2></div></div>
        <ul class="index">
          {guides.map((a) => (
            <li><a href={a.href}><span class="t">{a.frontmatter.title}</span><span class="d">{a.frontmatter.description}</span><span class="m">{tempsLecture(a.mots)} min</span></a></li>
          ))}
        </ul>
      </section>
    )}
    {autres.length > 0 && (
      <section class="section">
        <div class="section-tete"><div><p class="rubrique">Articles</p><h2>Les derniers articles</h2></div></div>
        <ul class="index">
          {autres.map((a) => (
            <li><a href={a.href}><span class="t">{a.frontmatter.title}</span><span class="d">{a.frontmatter.description}</span><span class="m">{formatDate(a.frontmatter.publie)}</span></a></li>
          ))}
        </ul>
      </section>
    )}
    {liste.length === 0 && <p class="section">Les premiers guides de cette rubrique arrivent très bientôt.</p>}
    {mots.length > 0 && (
      <section class="section">
        <div class="section-tete"><div><p class="rubrique">Lexique</p><h2>Les mots de la rubrique</h2></div><a class="fleche" href="/lexique/">Tout le lexique</a></div>
        <p style="font-size:16px;line-height:2;margin:0">{mots.map((t, i) => <>{i > 0 && <span aria-hidden="true" style="color:var(--doux)"> · </span>}<a href={t.href}>{t.frontmatter.terme}</a></>)}</p>
      </section>
    )}
  </div>
</Base>
