---
import '../styles/global.css';
import { SITE, CATEGORIES, AVERTISSEMENT } from '../lib/site';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  image?: string;
  jsonld?: object[];
  noindex?: boolean;
  publie?: string;
  misAJour?: string;
}
const { title, description, type = 'website', image = '/img/og-parlons-placement.png', jsonld = [], noindex = false, publie, misAJour } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title.includes(SITE.nom) ? title : `${title} | ${SITE.nom}`;
const ogImage = new URL(image, SITE.url).href;
const chemin = Astro.url.pathname;

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organisation`,
  name: SITE.nom,
  url: `${SITE.url}/`,
  logo: { '@type': 'ImageObject', url: `${SITE.url}/img/pp-logo-empile-sapin.png` },
  sameAs: [SITE.instagram],
  description: SITE.description,
};
const siteWeb = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#site`,
  name: SITE.nom,
  url: `${SITE.url}/`,
  inLanguage: 'fr-FR',
  publisher: { '@id': `${SITE.url}/#organisation` },
};
const schemas = [organisation, siteWeb, ...jsonld];
const actif = (h: string) => (chemin.startsWith(h) ? 'page' : undefined);
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
  <meta name="theme-color" content="#0F3D2E" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.nom} : derniers articles`} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preload" href="/fonts/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/InstrumentSerif-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:site_name" content={SITE.nom} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  {publie && <meta property="article:published_time" content={publie} />}
  {misAJour && <meta property="article:modified_time" content={misAJour} />}
  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <script is:inline>if ('IntersectionObserver' in window) document.documentElement.classList.add('anim');</script>
</head>
<body>
  <a class="saut" href="#contenu">Aller au contenu</a>
  <header class="tete">
    <div class="cadre">
      <a class="logo" href="/" aria-label="Parlons Placement, accueil"><img src="/img/pp-logo-horizontal-transparent-sapin.svg" alt="Parlons Placement" width="236" height="31" /></a>
      <nav class="nav" aria-label="Rubriques">
        {CATEGORIES.map((c) => <a href={`/${c.id}/`} aria-current={actif(`/${c.id}/`)}>{c.nom}</a>)}
        <span class="sep" aria-hidden="true"></span>
        <a href="/comparateurs/" aria-current={actif('/comparateurs/')}>Comparateurs</a>
        <a href="/simulateurs/" aria-current={actif('/simulateurs/')}>Simulateurs</a>
        <a href="/lexique/" aria-current={actif('/lexique/')}>Lexique</a>
        <a href="/evenements/" aria-current={actif('/evenements/')}>Agenda</a>
      </nav>
      <details class="menu">
        <summary>Menu</summary>
        <nav aria-label="Menu">
          {CATEGORIES.map((c) => <a href={`/${c.id}/`}>{c.nom}</a>)}
          <hr />
          <a href="/comparateurs/">Comparateurs</a>
          <a href="/simulateurs/">Simulateurs</a>
          <a href="/lexique/">Lexique</a>
          <a href="/evenements/">Agenda des événements</a>
          <hr />
          <a href="/methode/">Notre méthode</a>
        </nav>
      </details>
    </div>
  </header>
  <main id="contenu">
    <slot />
  </main>
  <footer class="pied">
    <div class="cadre">
      <div class="pied-grille">
        <div>
          <img src="/img/pp-logo-horizontal-transparent-papier.svg" alt="Parlons Placement" width="210" height="27" loading="lazy" />
          <p>L'argent, expliqué simplement. Des guides sourcés sur les textes officiels, des comparateurs neutres, des simulateurs. Jamais de conseil personnalisé.</p>
          <p><a href={SITE.instagram} rel="me">{SITE.instagramHandle} sur Instagram</a></p>
        </div>
        <div>
          <h2>Rubriques</h2>
          <ul>{CATEGORIES.map((c) => <li><a href={`/${c.id}/`}>{c.nom}</a></li>)}</ul>
        </div>
        <div>
          <h2>Outils</h2>
          <ul>
            <li><a href="/comparateurs/courtiers-en-bourse/">Comparateur des courtiers</a></li>
            <li><a href="/comparateurs/assurance-vie-en-ligne/">Comparateur assurance-vie</a></li>
            <li><a href="/simulateurs/interets-composes/">Intérêts composés</a></li>
            <li><a href="/simulateurs/impact-des-frais/">Impact des frais</a></li>
            <li><a href="/simulateurs/inflation/">Inflation</a></li>
            <li><a href="/simulateurs/capacite-d-emprunt/">Capacité d'emprunt</a></li>
            <li><a href="/lexique/">Lexique</a></li>
            <li><a href="/evenements/">Agenda des événements</a></li>
          </ul>
        </div>
        <div>
          <h2>Parlons Placement</h2>
          <ul>
            <li><a href="/a-propos/">Qui sommes-nous</a></li>
            <li><a href="/methode/">Notre méthode</a></li>
            <li><a href="/partenariats/">Partenariats et transparence</a></li>
            <li><a href="/avertissement/">Avertissement</a></li>
            <li><a href="/mentions-legales/">Mentions légales</a></li>
            <li><a href="/confidentialite/">Confidentialité</a></li>
          </ul>
        </div>
      </div>
      <div class="legal">
        <span>{AVERTISSEMENT}</span>
        <span>© {new Date().getFullYear()} Parlons Placement</span>
      </div>
    </div>
  </footer>
  <script is:inline>
    (() => {
      if (!('IntersectionObserver' in window)) return;
      const calme = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const compte = (el) => {
        if (calme) return;
        el.querySelectorAll('[data-compte]').forEach((n) => {
          const t = n.textContent;
          const m = t.match(/^([^\d−-]*)([−-]?\d{1,3}(?:[\u202f\u00a0 ]\d{3})+(?:,\d+)?|[−-]?\d+(?:,\d+)?)([\s\S]*)$/);
          if (!m) return;
          const v = parseFloat(m[2].replace(/[\s\u202f\u00a0]/g, '').replace(',', '.').replace('−', '-'));
          if (!isFinite(v)) return;
          const dec = (m[2].split(',')[1] || '').length;
          const f = new Intl.NumberFormat('fr-FR', { minimumFractionDigits: dec, maximumFractionDigits: dec });
          const t0 = performance.now();
          const pas = (now) => {
            const p = Math.min(1, (now - t0) / 900);
            n.textContent = m[1] + f.format(v * (1 - Math.pow(1 - p, 3))) + m[3];
            if (p < 1) requestAnimationFrame(pas); else n.textContent = t;
          };
          requestAnimationFrame(pas);
        });
      };
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('vu'); compte(e.target); io.unobserve(e.target);
      }), { threshold: 0.2 });
      document.querySelectorAll('.viz, .tableau-bord').forEach((el) => io.observe(el));
    })();
  </script>
</body>
</html>
